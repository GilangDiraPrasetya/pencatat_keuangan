# ============ DISCORD ============
# Token bot dari https://discord.com/developers/applications > Bot > Reset Token
DISCORD_TOKEN=

# (Opsional) ID channel khusus keuangan. Kosong = bot merespons hanya saat di-mention.
MONEY_CHANNEL_ID=

# ============ GOOGLE SHEETS ============
# ID spreadsheet (dari URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=
# Email service account Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Path file JSON key service account
SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# ============ AI (GEMINI) ============
# API key dari https://aistudio.google.com/apikey (gratis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ============ LAINNYA ============
BOT_TIMEZONE=Asia/Jakarta
AI_RATE_LIMIT_PER_MINUTE=8
